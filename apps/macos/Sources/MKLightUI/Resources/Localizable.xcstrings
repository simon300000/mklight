          }
        }
      }
    },
    "The expected value over random builds: nominal plus every tolerance's expected change over its distribution (independent errors add their changes of the mean-square criterion)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随机成品的期望值：标称值加上每个公差在其分布上的期望变化（独立误差对均方判据的变化相加）"
          }
        }
      }
    },
    "The eye rebuilds a trial in the window, read-only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼睛按钮会在窗口中重建试验（只读）。"
