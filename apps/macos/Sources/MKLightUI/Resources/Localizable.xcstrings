        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该玻璃没有名称。"
          }
        }
      }
    },
    "The glass is removed from %@. Designs that use it will not find it. This cannot be undone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
