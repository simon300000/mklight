<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the app's pure result readers and settings mapping (no WinUI). -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>MKLight.App.Tests</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\ResultData.cs" Link="Linked\ResultData.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Results\Readers\*.cs" Link="Linked\Readers\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\SettingsField.cs" Link="Linked\Settings\SettingsField.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\SettingControls.cs" Link="Linked\Settings\SettingControls.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\AutoSettings.cs" Link="Linked\Settings\AutoSettings.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\SettingEntry.cs" Link="Linked\Settings\SettingEntry.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\SettingsContext.cs" Link="Linked\Settings\SettingsContext.cs" />
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\SettingsSummary.cs" Link="Linked\Settings\SettingsSummary.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MKLight.App\Views\Analysis\Settings\Model\*.cs;..\..\src\MKLight.App\Views\Analysis\RunDetails\Model\*.cs" Link="Linked\SettingsModel\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\Views\Analysis\Results\ImageSimulationImport.cs;..\..\src\MKLight.App\Plotting\SparklineGeometry.cs" Link="Linked\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <!-- UI text lookup and language choice (Support/Loc.cs reads the English resw beside the tests). -->
    <Compile Include="..\..\src\MKLight.App\Support\Loc.cs;..\..\src\MKLight.App\Support\Languages.cs;..\..\src\MKLight.Model\EngineText.cs" Link="Localization\App\%(Filename)%(Extension)" />
    <None Include="..\..\src\MKLight.App\Strings\**\*.resw" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
