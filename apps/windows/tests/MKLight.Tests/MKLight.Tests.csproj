<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>MKLight.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MKLight.Model\MKLight.Model.csproj" />
    <ProjectReference Include="..\..\src\MKLight.Engine\MKLight.Engine.csproj" />
    <Compile Include="..\..\src\MKLight.App\ViewModels\LensTable*.cs" Link="Lens\App\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MKLight.App\ViewModels\Jobs\*.cs;..\..\src\MKLight.App\ViewModels\DesignDocument.cs" Link="Jobs\App\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MKLightNativeDir)mklight_ffi.dll" Condition="Exists('$(MKLightNativeDir)mklight_ffi.dll')" Link="mklight_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MKLight.App\Views\Viewport3D\Logic\*.cs" Link="Viewport\App\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\ViewModels\PanelArrangement*.cs;..\..\src\MKLight.App\ViewModels\WorkspaceLayout*.cs;..\..\src\MKLight.App\Views\Analysis\Results\ImageSimulationImport.cs" Link="Panels\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\Support\BenchPlan.cs" Link="Bench\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\ViewModels\GlassLibrary*.cs;..\..\src\MKLight.App\ViewModels\GlassBrowser*.cs" Link="Glass\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\ViewModels\SurfaceTypes.cs;..\..\src\MKLight.App\ViewModels\ShapeSag.cs;..\..\src\MKLight.App\ViewModels\InspectorModel.cs" Link="Inspector\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\Windows\ImportReport.cs;..\..\src\MKLight.App\Windows\DocumentFiles.cs;..\..\src\MKLight.App\Support\LaunchOptions.cs" Link="Documents\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\Views\Analysis\AnalysisPaneChrome.cs" Link="Panels\App\%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\src\MKLight.App\ViewModels\GpuPreparationMonitor.cs;..\..\src\MKLight.App\Views\StatusCapsuleModel.cs;..\..\src\MKLight.App\Views\Analysis\ResultData.cs;..\..\src\MKLight.App\Views\Analysis\Results\Readers\*.cs" Link="Status\App\%(Filename)%(Extension)" /></ItemGroup>
</Project>
