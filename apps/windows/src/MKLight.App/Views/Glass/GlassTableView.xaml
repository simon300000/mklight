<UserControl
    x:Class="MKLight.App.Views.Glass.GlassTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:MKLight.App.Views.Glass">
    <!-- The glass table: a header of sort buttons over a virtualised list. Header and rows
         share the column widths below; the whole table scrolls sideways when narrow. -->
    <UserControl.Resources>
        <Style x:Key="GlassCell" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
        <Style x:Key="GlassNumber" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="GlassSecondary" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}" />
        <Style x:Key="GlassSecondaryNumber" TargetType="TextBlock" BasedOn="{StaticResource SecondaryNumberText}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="CompactRow" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0,0,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Sideways" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="TableGrid" MinWidth="880">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Padding="16,4,0,4" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource HeaderRuleBrush}" Margin="12,0" />
                <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" Padding="0,4,0,4"
                          ItemContainerStyle="{StaticResource CompactRow}"
                          SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped" RightTapped="OnRightTapped"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="glass:GlassRowItem">
                            <Grid Height="26" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" MinWidth="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,8,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="{x:Bind NameWeight}" Style="{StaticResource GlassCell}" />
                                    <FontIcon Glyph="&#xE733;" FontSize="11" Visibility="{x:Bind ExcludedMark}" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              ToolTipService.ToolTip="Excluded from glass substitution" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Catalog}" Style="{StaticResource GlassSecondary}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Nd}" Foreground="{x:Bind NdBrush}" Style="{StaticResource GlassNumber}" ToolTipService.ToolTip="{x:Bind IrTip}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Vd}" Foreground="{x:Bind VdBrush}" Style="{StaticResource GlassNumber}" ToolTipService.ToolTip="{x:Bind IrTip}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Dpgf}" Style="{StaticResource GlassNumber}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{x:Bind StatusFill}" Stroke="{x:Bind StatusStroke}" StrokeThickness="1.2" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind StatusTitle}" Style="{StaticResource GlassCell}" />
                                    <FontIcon Glyph="&#xE77B;" FontSize="11" Visibility="{x:Bind OverriddenMark}" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              ToolTipService.ToolTip="Your setting (the catalog says otherwise)" />
                                </StackPanel>
                                <TextBlock Grid.Column="6" Text="{x:Bind Density}" Style="{StaticResource GlassNumber}" />
                                <TextBlock Grid.Column="7" Text="{x:Bind Cost}" Style="{StaticResource GlassNumber}" />
                                <TextBlock Grid.Column="8" Text="{x:Bind Tce}" Style="{StaticResource GlassNumber}" />
                                <TextBlock Grid.Column="9" Text="{x:Bind Lambda80}" Style="{StaticResource GlassNumber}" />
                                <TextBlock Grid.Column="10" Text="{x:Bind Range}" Style="{StaticResource GlassSecondaryNumber}" HorizontalAlignment="Left" TextAlignment="Left" Margin="6,0,8,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- No glasses: why, centred over the empty list. -->
                <StackPanel x:Name="Empty" Grid.Row="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon x:Name="EmptyIcon" Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource PanelTitleText}" HorizontalAlignment="Center" FontSize="15" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer: the count and how to use a glass. -->
        <Grid Grid.Row="1" Padding="16,6" ColumnSpacing="16" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" />
            <TextBlock Grid.Column="1" Text="Double-click a glass to use it for the selected surface" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
