<UserControl
    x:Class="MKLight.App.Views.StatusCapsule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The design's status, one capsule in the title bar's centre (no status bar):
         activity, EFL · F/# · TT, and the issues button. Details in a flyout. -->
    <Border Background="{ThemeResource CapsuleBrush}" BorderBrush="{ThemeResource CapsuleStrokeBrush}" BorderThickness="1"
            CornerRadius="16" Height="32" Padding="4,0">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <!-- The GPU's kernels being prepared at launch, then a short "GPU ready"; hidden when they load from the cache. -->
            <StackPanel x:Name="GpuBadge" Orientation="Horizontal" Spacing="6" Margin="8,0,4,0" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressRing x:Name="GpuRing" IsActive="False" Width="12" Height="12" MinWidth="12" MinHeight="12" />
                <TextBlock x:Name="GpuText" Style="{StaticResource SecondaryNumberText}" FontSize="12" />
            </StackPanel>
            <StackPanel x:Name="Activity" Orientation="Horizontal" Spacing="6" Margin="8,0,2,0" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="12" Height="12" MinWidth="12" MinHeight="12" />
                <TextBlock x:Name="ActivityText" Style="{StaticResource SecondaryNumberText}" FontSize="12" />
            </StackPanel>
            <!-- A previewed candidate: named in the capsule, with End Preview always at hand. -->
            <Border x:Name="PreviewBadge" Visibility="Collapsed" CornerRadius="13" Height="26" Padding="10,0,4,0" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="PreviewText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="EndPreviewButton" Content="End Preview" FontSize="11.5" Padding="8,1,8,2" CornerRadius="10" MinHeight="20" VerticalAlignment="Center" Click="OnEndPreview" />
                </StackPanel>
            </Border>
            <Button x:Name="NumbersButton" Background="Transparent" BorderThickness="0" CornerRadius="13" Height="26" Padding="10,0"
                    ToolTipService.ToolTip="First-order data, engine and compute backend">
                <StackPanel x:Name="Numbers" Orientation="Horizontal" Spacing="14" />
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="340" Spacing="4">
                            <StackPanel x:Name="Details" Spacing="4" />
                            <TextBlock Text="Compute On" Style="{StaticResource PanelTitleText}" Margin="0,10,0,2" />
                            <ComboBox x:Name="BackendPicker" HorizontalAlignment="Stretch" SelectionChanged="OnBackendChanged"
                                      ToolTipService.ToolTip="Where analyses compute. Automatic uses the GPU where the engine has a path and it pays off." />
                            <TextBlock x:Name="BackendNote" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="IssuesButton" Background="Transparent" BorderThickness="0" CornerRadius="13" Height="26" Padding="8,0"
                    Click="OnIssuesClick">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon x:Name="IssuesGlyph" Glyph="&#xE930;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="IssuesCount" Style="{StaticResource NumberText}" FontSize="12" Visibility="Collapsed" />
                </StackPanel>
                <FlyoutBase.AttachedFlyout>
                    <Flyout Placement="Bottom">
                        <ScrollViewer MaxHeight="420" Width="420">
                            <StackPanel x:Name="IssuesList" Spacing="8" />
                        </ScrollViewer>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
