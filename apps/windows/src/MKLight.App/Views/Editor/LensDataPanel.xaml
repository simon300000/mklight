<UserControl
    x:Class="MKLight.App.Views.LensDataPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MKLight.App.Views"
    IsTabStop="True" UseSystemFocusVisuals="False" TabFocusNavigation="Once"
    AutomationProperties.Name="Lens data" AutomationProperties.AutomationId="Panel.lens_data">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- The selected row: a calm accent tint (the focused table) or a neutral one. -->
                    <SolidColorBrush x:Key="LensSelectionBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.15" />
                    <SolidColorBrush x:Key="LensSelectionInactiveBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="LensBadgeFillBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="LensVariableBrush" Color="{ThemeResource SystemAccentColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LensSelectionBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.22" />
                    <SolidColorBrush x:Key="LensSelectionInactiveBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="LensBadgeFillBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="LensVariableBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LensSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LensSelectionInactiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LensBadgeFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="LensVariableBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Rows: rounded and inset like the Mac table, alternate rows striped. -->
            <Style x:Key="LensRow" TargetType="Border">
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="LensStripeRow" TargetType="Border" BasedOn="{StaticResource LensRow}">
                <Setter Property="Background" Value="{ThemeResource RowStripeBrush}" />
            </Style>
            <Style x:Key="LensSelectedRow" TargetType="Border" BasedOn="{StaticResource LensRow}">
                <Setter Property="Background" Value="{ThemeResource LensSelectionBrush}" />
            </Style>
            <Style x:Key="LensSelectedInactiveRow" TargetType="Border" BasedOn="{StaticResource LensRow}">
                <Setter Property="Background" Value="{ThemeResource LensSelectionInactiveBrush}" />
            </Style>
            <Style x:Key="LensHeaderDivider" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource DividerBrush}" />
            </Style>
            <!-- The accent pill at the selected row's leading edge (the Windows list selection). -->
            <Style x:Key="LensSelectionPill" TargetType="Border">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="1.5" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="LensText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />
            <Style x:Key="LensNumber" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="LensDimNumber" TargetType="TextBlock" BasedOn="{StaticResource LensNumber}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="LensSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LensSecondaryNumber" TargetType="TextBlock" BasedOn="{StaticResource LensNumber}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LensSurfaceLabel" TargetType="TextBlock" BasedOn="{StaticResource NumberText}" />
            <Style x:Key="LensRoleLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LensStopLabel" TargetType="TextBlock" BasedOn="{StaticResource LensRoleLabel}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- The y / x before a section of an anamorphic surface. -->
            <Style x:Key="LensHint" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="0,1,4,0" />
            </Style>
            <!-- A melt offset after its glass. -->
            <Style x:Key="LensNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Setter Property="Margin" Value="5,1,0,0" />
            </Style>

            <!-- Inline markers: a solve's letter on a soft fill, a variable's V outlined in the accent. -->
            <Style x:Key="LensSolveBadge" TargetType="Border">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource LensBadgeFillBrush}" />
            </Style>
            <Style x:Key="LensVariableBadge" TargetType="Border" BasedOn="{StaticResource LensSolveBadge}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource LensVariableBrush}" />
            </Style>
            <Style x:Key="LensVariableIgnoredBadge" TargetType="Border" BasedOn="{StaticResource LensVariableBadge}">
                <Setter Property="BorderBrush" Value="{ThemeResource WarningBrush}" />
            </Style>
            <Style x:Key="LensBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="LensVariableText" TargetType="TextBlock" BasedOn="{StaticResource LensBadgeText}">
                <Setter Property="Foreground" Value="{ThemeResource LensVariableBrush}" />
            </Style>
            <Style x:Key="LensVariableIgnoredText" TargetType="TextBlock" BasedOn="{StaticResource LensBadgeText}">
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
            </Style>
            <Style x:Key="LensBoundMark" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LensVariableBrush}" />
            </Style>

            <Style x:Key="LensWarningGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Glyph" Value="&#xE7BA;" />
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style x:Key="LensErrorGlyph" TargetType="FontIcon" BasedOn="{StaticResource LensWarningGlyph}">
                <Setter Property="Glyph" Value="&#xEA39;" />
                <Setter Property="Foreground" Value="{ThemeResource ErrorBrush}" />
            </Style>
            <Style x:Key="LensStopGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Glyph" Value="&#xE7C8;" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="4,1,0,0" />
            </Style>

            <!-- The type cell: a borderless menu button, glyph · title · chevron. -->
            <Style x:Key="LensTypeButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="5,0,4,0" />
                <Setter Property="Height" Value="22" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="LensTypeGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,1,7,0" />
            </Style>
            <Style x:Key="LensChevron" TargetType="FontIcon">
                <Setter Property="FontSize" Value="8" />
                <Setter Property="Glyph" Value="&#xE70D;" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="6,1,0,0" />
            </Style>

            <!-- The one text field: compact, in place over the cell. -->
            <Style x:Key="LensEditor" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="5,2,5,2" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
            </Style>
            <Style x:Key="LensSuggestionItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0,12,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <!-- Glass-name suggestions under the material field: a menu-like flyout surface. -->
            <Style x:Key="LensSuggestions" TargetType="Border">
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Panel header: title, counts and unit, then insert, delete and More. -->
        <local:LensAutomationGroup x:Name="PanelHeader" Padding="14,7,8,3" ColumnSpacing="8" ControlType="Header"
                                   AutomationProperties.Name="Lens Data" AutomationProperties.AutomationId="Panel.lens_data.Header">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE80A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1" Text="Lens Data" Style="{StaticResource PanelTitleText}" />
            <TextBlock x:Name="Caption" Grid.Column="2" Style="{StaticResource CaptionText}" Margin="0,1,0,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <Button x:Name="VariablesButton" Style="{StaticResource CapsuleButton}" Visibility="Collapsed" Padding="8,1,10,2" MinHeight="24"
                        Background="Transparent" BorderThickness="0" Click="OnVariablesClick" IsTabStop="False" Margin="0,0,4,0"
                        ToolTipService.ToolTip="The design's variables: open Optimize to edit their bounds">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Style="{StaticResource LensVariableBadge}" VerticalAlignment="Center">
                            <TextBlock Text="V" Style="{StaticResource LensVariableText}" />
                        </Border>
                        <TextBlock x:Name="VariablesText" Style="{StaticResource NumberText}" FontSize="12" Foreground="{ThemeResource LensVariableBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="InsertButton" Style="{StaticResource CircleButton}" Width="26" Height="26" Content="&#xE710;" FontSize="12"
                        Click="OnInsertClick" IsTabStop="False"
                        ToolTipService.ToolTip="Insert a surface before the selection (Ctrl+Shift+I)"
                        AutomationProperties.Name="Insert Surface" />
                <Button x:Name="DeleteButton" Style="{StaticResource CircleButton}" Width="26" Height="26" Content="&#xE738;" FontSize="12"
                        Click="OnDeleteClick" IsTabStop="False"
                        ToolTipService.ToolTip="Delete the selected surface (Ctrl+Delete)"
                        AutomationProperties.Name="Delete Surface" />
                <Button x:Name="MoreButton" Style="{StaticResource CircleButton}" Width="26" Height="26" Content="&#xE712;" FontSize="12"
                        IsTabStop="False" ToolTipService.ToolTip="More"
                        AutomationProperties.Name="More" AutomationProperties.AutomationId="Panel.lens_data.More">
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:LensAutomationGroup>

        <!-- The grid: columns scroll sideways together; rows scroll under the pinned column header. -->
        <ScrollViewer x:Name="HorizontalScroller" Grid.Row="1"
                      HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      SizeChanged="OnScrollerSizeChanged" IsTabStop="False">
            <Grid x:Name="Table" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <local:LensAutomationGroup x:Name="ColumnHeader" Height="28" Margin="8,0" ControlType="Header"
                                           AutomationProperties.Name="Columns" AutomationProperties.AutomationId="LensTable.Header" />
                <Border Height="1" Margin="0" VerticalAlignment="Bottom" Background="{ThemeResource HeaderRuleBrush}" />
                <ScrollViewer x:Name="RowScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                    <Grid x:Name="RowsHost" Margin="8,3,8,8" Background="Transparent">
                        <StackPanel x:Name="RowsPanel" />
                        <Canvas x:Name="Overlay" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
