<UserControl
    x:Class="MKLight.App.Views.Analysis.AnalysisPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MKLight.App.Views.Analysis">
    <!-- An analysis pane: header (title, analysis menu, state line, button cluster), the preview banner
         while a candidate is previewed, optional settings form, the plot (content), footer (key numbers,
         backend badge). -->
    <Grid x:Name="Root" Background="{ThemeResource ContentSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Focus marker: a thin accent line along the top of the focused pane. -->
        <Border x:Name="FocusBar" Height="2" VerticalAlignment="Top" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" Grid.RowSpan="5" />

        <local:AnalysisPaneGroup x:Name="Header" Padding="10,8,6,6" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="0" MinWidth="0">
                <!-- The title: drag it to move the pane; click it for another analysis. -->
                <local:AnalysisPaneTitleButton x:Name="TitleButton" Padding="2,0,4,0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="TitleGlyph" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TitleText" Style="{StaticResource PanelTitleText}" TextTrimming="CharacterEllipsis" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AnalysisMenu" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </local:AnalysisPaneTitleButton>
                <TextBlock x:Name="StateText" Style="{StaticResource CaptionText}" Margin="3,1,0,0" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <StackPanel x:Name="Cluster" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="0">
                <Button x:Name="RunButton" Style="{StaticResource CircleButton}" Content="&#xE72C;" Click="OnRun" ToolTipService.ToolTip="Run again (F5)" />
                <ToggleButton x:Name="AutoButton" Style="{StaticResource CircleToggleButton}" Content="&#xE945;" Click="OnAutoUpdate"
                              AutomationProperties.Name="Update Automatically" />
                <ToggleButton x:Name="SettingsButton" Style="{StaticResource CircleToggleButton}" Content="&#xE9E9;" Click="OnSettingsToggle"
                              AutomationProperties.Name="Settings" />
                <Button x:Name="MoreButton" Style="{StaticResource CircleButton}" Content="&#xE712;" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" Opening="OnMoreOpening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </local:AnalysisPaneGroup>

        <ProgressBar x:Name="Progress" Grid.Row="0" VerticalAlignment="Bottom" Margin="10,0" Visibility="Collapsed" IsIndeterminate="True" MinHeight="2" />

        <!-- A previewed candidate: a row of its own, so it never covers the plot or its legend. -->
        <local:AnalysisPaneGroup x:Name="PreviewBanner" Grid.Row="1" Visibility="Collapsed" Margin="8,0,8,6" MinHeight="24">
            <Border CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.13" />
            <Border CornerRadius="6" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" Opacity="0.5" />
            <Grid Padding="8,3,10,4" ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7B3;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="PreviewText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <Run x:Name="PreviewTitleRun" FontWeight="SemiBold" /><Run x:Name="PreviewNoteRun" Text=" · not applied" />
                </TextBlock>
            </Grid>
        </local:AnalysisPaneGroup>

        <!-- Settings: a grouped card in the content layer, generated from the engine's schema. -->
        <Border x:Name="SettingsHost" Grid.Row="2" Visibility="Collapsed" Margin="8,0,8,6" CornerRadius="8" Padding="10,8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ContentPresenter x:Name="SettingsContent" />
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button Content="Defaults" Style="{StaticResource CapsuleButton}" Click="OnDefaults" />
                    <Button Content="Done" Style="{StaticResource CapsuleButton}" Click="OnSettingsDone" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <!-- The pulse breathes this while the result updates; the stale dimming is on the result itself. -->
            <Grid x:Name="PulseHost">
                <ContentPresenter x:Name="ResultHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ContentPresenter.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                    </ContentPresenter.OpacityTransition>
                </ContentPresenter>
            </Grid>
            <!-- Placeholders: running, not available, design has errors, failed, not ready, cancelled, on request. -->
            <local:AnalysisPaneGroup x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" Margin="12" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <FontIcon x:Name="MessageGlyph" FontSize="30" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,4" />
                    <ProgressBar x:Name="MessageProgress" Width="160" IsIndeterminate="True" Visibility="Collapsed" />
                    <ProgressRing x:Name="MessageRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="MessageTitle" Style="{StaticResource PanelTitleText}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" HorizontalAlignment="Center" MaxLines="6" />
                    <Button x:Name="MessageAction" Style="{StaticResource CapsuleButton}" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,4,0,0" Click="OnMessageAction" />
                </StackPanel>
            </local:AnalysisPaneGroup>
            <!-- Stale: the result dims under a glass card with the one prominent action, Update. -->
            <Border x:Name="StaleCard" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{ThemeResource StaleCardBrush}" BorderBrush="{ThemeResource CapsuleStrokeBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,12">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="StaleTitle" Text="Design changed" Style="{StaticResource PanelTitleText}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StaleReason" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Text="This result is from an earlier design." />
                    <Button x:Name="StaleUpdate" Content="Update" Style="{StaticResource AccentCapsuleButton}" HorizontalAlignment="Center" Click="OnUpdate" />
                </StackPanel>
            </Border>
            <!-- A rerun failed: the last result stays; this capsule says so, the message on hover and click. -->
            <Button x:Name="FailedCapsule" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,10"
                    Padding="10,4,12,5" CornerRadius="14" MinHeight="26" BorderThickness="1" Translation="0,0,16"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CapsuleStrokeBrush}">
                <Button.Shadow>
                    <ThemeShadow />
                </Button.Shadow>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource WarningBrush}" />
                    <TextBlock x:Name="FailedText" Grid.Column="1" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Width="300" Spacing="8">
                            <TextBlock Text="The update failed" Style="{StaticResource PanelTitleText}" />
                            <TextBlock x:Name="FailedMessage" Style="{StaticResource BodyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="The result shown is from the last run that succeeded." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <Button x:Name="FailedRetry" Content="Try Again" Style="{StaticResource CapsuleButton}" HorizontalAlignment="Right" Click="OnRetry" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="4" Padding="10,5,8,7" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="KeyNumbers" Style="{StaticResource CaptionText}" FontSize="11.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Button x:Name="BackendBadge" Grid.Column="1" Padding="8,1,9,2" CornerRadius="10" MinHeight="20" BorderThickness="1"
                    Background="{ThemeResource CapsuleBrush}" BorderBrush="{ThemeResource CapsuleStrokeBrush}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon x:Name="BackendWarning" Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource WarningBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="BackendGlyph" Glyph="&#xE950;" FontSize="11" />
                    <TextBlock x:Name="BackendText" Style="{StaticResource NumberText}" FontSize="11" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedRight">
                        <StackPanel x:Name="RunDetails" Width="340" Spacing="4" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
