<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      MKLight's Fluent translation of the Mac app's design brief (docs/WINDOWS.md "Look"):
      Mica behind the window, acrylic ("glass") only on floating controls, the sidebar and
      chrome; content (table, plots, layout) is plain and crisp on an opaque surface. The
      accent is kept for selection, the focused pane, variables, the GPU badge and the one
      primary action. Every number uses tabular figures (NumberText styles).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- The plot surface of the Mac app's Palette (0xfcfcfb / 0x1a1a19). -->
            <Color x:Key="ContentSurfaceColor">#FFFCFCFB</Color>
            <Color x:Key="ContentStrokeColor">#14000000</Color>
            <Color x:Key="DividerColor">#12000000</Color>
            <Color x:Key="RowStripeColor">#06000000</Color>
            <Color x:Key="HeaderRuleColor">#1F000000</Color>
            <Color x:Key="PlotGridColor">#14000000</Color>
            <Color x:Key="PlotAxisColor">#59000000</Color>
            <Color x:Key="PlotLabelColor">#99000000</Color>
            <Color x:Key="PlotTitleColor">#C4000000</Color>
            <Color x:Key="CapsuleColor">#B3FFFFFF</Color>
            <Color x:Key="CapsuleStrokeColor">#17000000</Color>
            <Color x:Key="WarningColor">#FFE07800</Color>
            <Color x:Key="ErrorColor">#FFD13438</Color>
            <Color x:Key="StaleCardColor">#E6FFFFFF</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ContentSurfaceColor">#FF1A1A19</Color>
            <Color x:Key="ContentStrokeColor">#1FFFFFFF</Color>
            <Color x:Key="DividerColor">#17FFFFFF</Color>
            <Color x:Key="RowStripeColor">#08FFFFFF</Color>
            <Color x:Key="HeaderRuleColor">#24FFFFFF</Color>
            <Color x:Key="PlotGridColor">#17FFFFFF</Color>
            <Color x:Key="PlotAxisColor">#66FFFFFF</Color>
            <Color x:Key="PlotLabelColor">#A6FFFFFF</Color>
            <Color x:Key="PlotTitleColor">#D9FFFFFF</Color>
            <Color x:Key="CapsuleColor">#33FFFFFF</Color>
            <Color x:Key="CapsuleStrokeColor">#1AFFFFFF</Color>
            <Color x:Key="WarningColor">#FFFF9F2E</Color>
            <Color x:Key="ErrorColor">#FFFF6B6B</Color>
            <Color x:Key="StaleCardColor">#D92C2C2C</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="ContentSurfaceColor">#FF000000</Color>
            <Color x:Key="ContentStrokeColor">#FFFFFFFF</Color>
            <Color x:Key="DividerColor">#FFFFFFFF</Color>
            <Color x:Key="RowStripeColor">#00000000</Color>
            <Color x:Key="HeaderRuleColor">#FFFFFFFF</Color>
            <Color x:Key="PlotGridColor">#80FFFFFF</Color>
            <Color x:Key="PlotAxisColor">#FFFFFFFF</Color>
            <Color x:Key="PlotLabelColor">#FFFFFFFF</Color>
            <Color x:Key="PlotTitleColor">#FFFFFFFF</Color>
            <Color x:Key="CapsuleColor">#FF000000</Color>
            <Color x:Key="CapsuleStrokeColor">#FFFFFFFF</Color>
            <Color x:Key="WarningColor">#FFFFFF00</Color>
            <Color x:Key="ErrorColor">#FFFF0000</Color>
            <Color x:Key="StaleCardColor">#FF000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="ContentSurfaceBrush" Color="{ThemeResource ContentSurfaceColor}" />
    <SolidColorBrush x:Key="ContentStrokeBrush" Color="{ThemeResource ContentStrokeColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource DividerColor}" />
    <SolidColorBrush x:Key="RowStripeBrush" Color="{ThemeResource RowStripeColor}" />
    <SolidColorBrush x:Key="HeaderRuleBrush" Color="{ThemeResource HeaderRuleColor}" />
    <SolidColorBrush x:Key="CapsuleBrush" Color="{ThemeResource CapsuleColor}" />
    <SolidColorBrush x:Key="CapsuleStrokeBrush" Color="{ThemeResource CapsuleStrokeColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource ErrorColor}" />
    <SolidColorBrush x:Key="StaleCardBrush" Color="{ThemeResource StaleCardColor}" />

    <!-- The sidebar and the content area: the sidebar sits on Mica; content is opaque. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>

    <!-- The Mac app's spacing scale (Space: 2, 4, 6, 8, 12, 16, 24). -->
    <x:Double x:Key="SpaceXXS">2</x:Double>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">6</x:Double>
    <x:Double x:Key="SpaceM">8</x:Double>
    <x:Double x:Key="SpaceL">12</x:Double>
    <x:Double x:Key="SpaceXL">16</x:Double>
    <x:Double x:Key="SpaceXXL">24</x:Double>

    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="UIDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Every number: tabular figures, so columns and changing values never jitter. -->
    <Style x:Key="NumberText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SecondaryNumberText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="PanelTitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="ColumnHeaderText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="IconGlyph" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--
      Small circular "glass" icon button: the pane header cluster and floating controls
      (the Mac's circular glass buttons). Subtle at rest, a soft fill on hover.
    -->
    <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="CircleToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A capsule button: the floating controls, the status capsule's parts, the welcome actions. -->
    <Style x:Key="CapsuleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,3,12,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="AccentCapsuleButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="14,3,14,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Floating glass chip (layout title, controls over the scene): in-app acrylic. -->
    <Style x:Key="GlassChip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CapsuleStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="2" />
    </Style>
</ResourceDictionary>
