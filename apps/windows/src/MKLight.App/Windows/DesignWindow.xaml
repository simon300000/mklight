<Window
    x:Class="MKLight.App.Windows.DesignWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MKLight.App.Views">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: icon, menu bar and design name, the status capsule in the centre,
             Add Analysis and the inspector toggle trailing (the Mac toolbar's groups). -->
        <TitleBar x:Name="AppTitleBar" Height="52"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <!-- The menu bar starts right after the icon (the title bar centres its content otherwise). -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <Thickness x:Key="TitleBarIconMargin">0,0,6,0</Thickness>
                <!-- Compact items, as Windows 11 apps' menu bars have them. -->
                <Thickness x:Key="MenuBarItemButtonPadding">8,4,8,4</Thickness>
                <Thickness x:Key="MenuBarItemMargin">2,0,2,0</Thickness>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <!-- The menu bar after the icon (as Notepad and Paint have it), on Mica; the design's name after it. -->
            <TitleBar.Content>
                <Grid x:Name="MenuArea" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <MenuBar x:Name="Menus" Background="Transparent" VerticalAlignment="Center" Height="32" />
                    <TextBlock x:Name="DocTitle" Grid.Column="1" Margin="10,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!-- Undo, Redo, Add Analysis and the inspector toggle, trailing before the caption buttons (over the title
             bar, as its right header would sit too far left: its inset is taken in pixels, not in view units). -->
        <StackPanel x:Name="RightButtons" Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="UndoButton" Style="{StaticResource CircleButton}" Content="&#xE7A7;" Click="OnUndo" ToolTipService.ToolTip="Undo (Ctrl+Z)" />
            <Button x:Name="RedoButton" Style="{StaticResource CircleButton}" Content="&#xE7A6;" Click="OnRedo" ToolTipService.ToolTip="Redo (Ctrl+Y)" />
            <Border x:Name="UndoDivider" Width="1" Height="18" Margin="6,0" Background="{ThemeResource DividerBrush}" />
            <DropDownButton x:Name="AddAnalysisButton" Height="30" CornerRadius="15" Padding="9,0,7,0"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Add an analysis pane">
                <FontIcon Glyph="&#xECCD;" FontSize="14" />
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="AddAnalysisMenu" Placement="BottomEdgeAlignedRight" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton x:Name="InspectorToggle" Style="{StaticResource CircleToggleButton}" Content="&#xE89F;"
                          IsChecked="True" Click="OnInspectorToggle" ToolTipService.ToolTip="Show or hide the inspector (Ctrl+Alt+P)" />
        </StackPanel>

        <!-- The status capsule, centred on the window (pointer input passes through the title bar there). -->
        <views:StatusCapsule x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False" OpenPaneLength="248" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnSidebarSelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SidebarSearch" PlaceholderText="Analyses" QueryIcon="Find"
                                TextChanged="OnSidebarSearchChanged" />
            </NavigationView.AutoSuggestBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Content: one opaque, crisp surface; no glass on content. -->
                <Border x:Name="ContentCard" Background="{ThemeResource ContentSurfaceBrush}"
                        BorderBrush="{ThemeResource ContentStrokeBrush}" BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                </Border>

                <!-- Inspector column: on Mica like the sidebar (chrome, not content); pages from InspectorPages. -->
                <Border x:Name="Inspector" Grid.Column="1" />
            </Grid>
        </NavigationView>

        <!-- Transient message: a glass toast at the bottom centre. -->
        <Border x:Name="Toast" Grid.Row="1" Style="{StaticResource GlassChip}" Padding="16,8" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" />
        </Border>
    </Grid>
</Window>
