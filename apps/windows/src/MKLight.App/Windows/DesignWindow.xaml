<Window
    x:Class="MKLight.App.Windows.DesignWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MKLight.App.Views">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: icon, file and design name, the status capsule in the centre,
             Add Analysis and the inspector toggle trailing (the Mac toolbar's groups). -->
        <TitleBar x:Name="AppTitleBar" Height="52"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <views:StatusCapsule x:Name="Status" HorizontalAlignment="Center" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource CircleButton}" Content="&#xE7A7;" Click="OnUndo" ToolTipService.ToolTip="Undo (Ctrl+Z)" />
                    <Button x:Name="RedoButton" Style="{StaticResource CircleButton}" Content="&#xE7A6;" Click="OnRedo" ToolTipService.ToolTip="Redo (Ctrl+Y)" />
                    <Border Width="1" Height="18" Margin="6,0" Background="{ThemeResource DividerBrush}" />
                    <DropDownButton x:Name="AddAnalysisButton" Height="30" CornerRadius="15" Padding="9,0,7,0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Add an analysis pane">
                        <FontIcon Glyph="&#xECCD;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="AddAnalysisMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="FileButton" Style="{StaticResource CircleButton}" Content="&#xE8A5;" ToolTipService.ToolTip="File">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="New from Sample…" Click="OnNew"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open…" Click="OnOpen"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open Recent"><MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon></MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Save" Click="OnSave"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save As…" Click="OnSaveAs" />
                                <MenuFlyoutSeparator />
                                <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System Appearance" GroupName="theme" Click="OnTheme" Tag="system" />
                                <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="theme" Click="OnTheme" Tag="light" />
                                <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="theme" Click="OnTheme" Tag="dark" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="InspectorToggle" Style="{StaticResource CircleToggleButton}" Content="&#xE89F;"
                                  IsChecked="True" Click="OnInspectorToggle" ToolTipService.ToolTip="Show or hide the inspector (Ctrl+Alt+I)" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False" OpenPaneLength="248" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnSidebarSelectionChanged">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SidebarSearch" PlaceholderText="Analyses" QueryIcon="Find"
                                TextChanged="OnSidebarSearchChanged" />
            </NavigationView.AutoSuggestBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="280" />
                </Grid.ColumnDefinitions>

                <!-- Content: one opaque, crisp surface; no glass on content. -->
                <Border x:Name="ContentCard" Background="{ThemeResource ContentSurfaceBrush}"
                        BorderBrush="{ThemeResource ContentStrokeBrush}" BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                    <Grid x:Name="ContentGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.36*" MinHeight="150" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="0.64*" />
                        </Grid.RowDefinitions>
                        <views:LensDataPanel x:Name="LensData" />
                        <Border Grid.Row="1" Background="{ThemeResource DividerBrush}" />
                        <Grid x:Name="PanelsRow" Grid.Row="2" />
                    </Grid>
                </Border>

                <!-- Inspector column: on Mica like the sidebar (chrome, not content). -->
                <Grid x:Name="Inspector" Grid.Column="1" Padding="12,4,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource GlassChip}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="InspectorSurfaceTab" Content="Surface" IsChecked="True" CornerRadius="13" Height="26" Padding="12,0" BorderThickness="0" Click="OnInspectorTab" />
                            <ToggleButton x:Name="InspectorSystemTab" Content="System" CornerRadius="13" Height="26" Padding="12,0" BorderThickness="0" Background="Transparent" Click="OnInspectorTab" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24">
                            <FontIcon Glyph="&#xE8A1;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="InspectorTitle" Style="{StaticResource PanelTitleText}" HorizontalAlignment="Center" Text="Inspector" />
                            <TextBlock x:Name="InspectorCaption" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="200"
                                       Text="Surface and system parameters arrive in a later round." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Transient message: a glass toast at the bottom centre. -->
        <Border x:Name="Toast" Grid.Row="1" Style="{StaticResource GlassChip}" Padding="16,8" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" />
        </Border>
    </Grid>
</Window>
